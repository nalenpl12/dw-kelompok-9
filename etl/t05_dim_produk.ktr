  <step>
    <name>Input Dim Produk</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>dw</connection>
    <sql>SELECT
    produk_id,
    nama_produk,
    nomor_produk,
    standard_cost,
    reorder_point,
    COALESCE(raw_date_from, '1900-01-01') AS date_from,
    COALESCE(raw_date_to, '9999-12-31') AS date_to,
    is_current
FROM (
    SELECT
        p.product_id AS produk_id,
        COALESCE(NULLIF(TRIM(p.name), ''), 'Tidak Diketahui') AS nama_produk,
        COALESCE(NULLIF(TRIM(p.product_number), ''), '-') AS nomor_produk,
        COALESCE(pch.standard_cost, p.standard_cost, 0.0000) AS standard_cost,
        COALESCE(p.reorder_point, 0) AS reorder_point,
        CASE
            WHEN pch.start_date IS NULL OR LEFT(TRIM(CAST(pch.start_date AS CHAR)), 10) IN ('', '0000-00-00') THEN '1900-01-01'
            WHEN ROW_NUMBER() OVER (PARTITION BY p.product_id ORDER BY pch.start_date) = 1 THEN '1900-01-01'
            ELSE DATE_FORMAT(pch.start_date, '%Y-%m-%d')
        END AS raw_date_from,
        CASE
            WHEN LEAD(pch.start_date) OVER (PARTITION BY p.product_id ORDER BY pch.start_date) IS NULL
                 OR LEFT(TRIM(CAST(LEAD(pch.start_date) OVER (PARTITION BY p.product_id ORDER BY pch.start_date) AS CHAR)), 10) IN ('', '0000-00-00')
            THEN '9999-12-31'
            ELSE DATE_FORMAT(DATE_SUB(LEAD(pch.start_date) OVER (PARTITION BY p.product_id ORDER BY pch.start_date), INTERVAL 1 DAY), '%Y-%m-%d')
        END AS raw_date_to,
        CASE
            WHEN LEAD(pch.start_date) OVER (PARTITION BY p.product_id ORDER BY pch.start_date) IS NULL THEN 1
            ELSE 0
        END AS is_current
    FROM stg_product p
    LEFT JOIN stg_product_cost_history pch
        ON p.product_id = pch.product_id
) AS sub;</sql>
